DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a high entropy value; external log sources must send X-Log-Token.
LOG_INGEST_TOKEN=replace-with-a-random-ingestion-token
# Optional PostgreSQL configuration. Leave DB_NAME unset to use SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# SMTP is optional. Configure a real backend and credentials to send email.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=server-monitor@example.org
ALERT_EMAIL_RECIPIENTS=operations@example.org
# Optional Redis channel layer, e.g. redis://localhost:6379/0
REDIS_URL=
